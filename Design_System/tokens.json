{
  "$description": "Civil Portal (NCL Colony Maintenance) — v4 theme. Style Dictionary format. Single source for Tailwind, Compose and SwiftUI.",
  "color": {
    "light": {
      "bg":        { "value": "#F8F6EF", "comment": "cream page background" },
      "surface":   { "value": "#FFFFFF" },
      "border":    { "value": "#EAE8E0" },
      "border2":   { "value": "#DDD9CC", "comment": "inputs, stronger dividers" },
      "text":      { "value": "#1C2B2B" },
      "textMuted": { "value": "#617074" },
      "primary":   { "value": "#0F4C4C", "comment": "actions, sidebar, headings accent" },
      "primaryDark": { "value": "#0A3333", "comment": "toasts, scorecard gradient end, text on gold" },
      "muted":     { "value": "#EFEDE4", "comment": "chip / ghost button fill" },
      "tint":      { "value": "#E8F4F4", "comment": "selected row, active tab fill" },
      "sidebar":   { "value": "#0F4C4C" }
    },
    "dark": {
      "bg":        { "value": "#0E1A1A" },
      "surface":   { "value": "#152424" },
      "border":    { "value": "#22393A" },
      "border2":   { "value": "#2E4A4B" },
      "text":      { "value": "#E7EDEA" },
      "textMuted": { "value": "#A4B4B3" },
      "primary":   { "value": "#8FD3CB", "comment": "text/icon accent in dark" },
      "primaryButton": { "value": "#1A6B6B" },
      "muted":     { "value": "#1B2E2E" },
      "tint":      { "value": "#1D3838" },
      "sidebar":   { "value": "#0B2626" }
    },
    "brand": {
      "secondary": { "value": "#2E7D32", "comment": "green — resolved / success" },
      "gold":      { "value": "#C9A96A", "comment": "decorative: active nav dot, SLA ring fill, logo ring. NOT for text on light" },
      "goldText":  { "value": "#B08F4E", "comment": "gold for text ≥ 18px bold only" },
      "emSlot":    { "value": "#7A4B1F", "comment": "reserved for future E&M portal accent" }
    },
    "status": {
      "resolved": { "value": "#1F6F4A" },
      "atRisk":   { "value": "#8A5A00" },
      "breached": { "value": "#A32A21" },
      "info":     { "value": "#2C5A8A" }
    }
  },
  "font": {
    "ui":        { "value": "Poppins, 'Noto Sans Devanagari', system-ui, sans-serif" },
    "quote":     { "value": "'Playfair Display', Georgia, serif", "comment": "resident testimonials / hero pull-quote only" },
    "devanagari":{ "value": "'Noto Sans Devanagari'", "comment": "+3–4px line-height vs Latin at same size" },
    "numeric":   { "value": "font-variant-numeric: tabular-nums", "comment": "all KPIs and table numbers" }
  },
  "type": {
    "display": { "size": "48px", "weight": 700, "lineHeight": 1.1 },
    "h1":      { "size": "30px", "weight": 700, "lineHeight": 1.2 },
    "h2":      { "size": "22px", "weight": 600, "lineHeight": 1.3 },
    "h3":      { "size": "18px", "weight": 600, "lineHeight": 1.35 },
    "h4":      { "size": "16px", "weight": 600, "lineHeight": 1.4 },
    "body":    { "size": "14px", "weight": 400, "lineHeight": 1.55 },
    "small":   { "size": "13px", "weight": 400, "lineHeight": 1.5 },
    "caption": { "size": "12px", "weight": 500, "lineHeight": 1.4 },
    "label":   { "size": "11px", "weight": 600, "lineHeight": 1.3, "letterSpacing": "0.08em", "textTransform": "uppercase", "comment": "section labels / table headers (v4 template convention)" },
    "kpi":     { "size": "30px", "weight": 700, "lineHeight": 1.1 }
  },
  "space": { "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "20px", "6": "24px", "7": "28px", "8": "32px", "10": "40px", "12": "48px", "16": "64px" },
  "radius": {
    "input": "10px", "card": "14px", "cardLarge": "16px", "scorecard": "20px", "dialog": "20px",
    "sheet": "24px 24px 0 0", "pill": "999px"
  },
  "shadow": {
    "none":    "none",
    "float":   "0 8px 24px rgba(10,51,51,.12)",
    "dialog":  "0 24px 64px rgba(10,51,51,.28)",
    "sheet":   "0 -12px 32px rgba(0,0,0,.25)"
  },
  "scrim": { "value": "rgba(10,51,51,.5)" },
  "motion": {
    "fast": "150ms cubic-bezier(.2,.7,.2,1)",
    "base": "240ms cubic-bezier(.2,.7,.2,1)",
    "sheet": "320ms cubic-bezier(.2,.7,.2,1)",
    "heroSettle": "2600ms cubic-bezier(.2,.7,.2,1)"
  },
  "touch": { "minTarget": "44px" }
}
